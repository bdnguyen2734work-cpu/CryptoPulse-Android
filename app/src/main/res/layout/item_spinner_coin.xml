<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingVertical="12dp"
    android:gravity="center_vertical" android:background="@color/bg_card">

    <androidx.cardview.widget.CardView
        android:layout_width="36dp" android:layout_height="36dp"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="18dp"
        app:cardBackgroundColor="#1AFFFFFF"
        app:cardElevation="0dp">
        <ImageView android:id="@+id/iv_coin_logo"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:padding="4dp"/>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView android:id="@+id/tv_coin_symbol"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/text_primary" android:textSize="16sp"
            android:textStyle="bold" android:fontFamily="sans-serif"/>

        <TextView android:id="@+id/tv_coin_name"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/text_secondary" android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>

</LinearLayout>