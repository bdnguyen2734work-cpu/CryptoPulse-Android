<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/detail_header"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:padding="20dp">
            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="32dp" android:layout_height="32dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/text_primary"
                android:layout_marginEnd="12dp" android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"/>
            <TextView
                android:id="@+id/tv_detail_symbol"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="20sp" android:textColor="@color/text_primary"
                android:fontFamily="sans-serif" android:textStyle="bold"/>
            <ImageView
                android:id="@+id/btn_favorite"
                android:layout_width="32dp" android:layout_height="32dp"
                android:padding="4dp"
                android:src="@drawable/ic_star_outline"
                app:tint="@color/text_secondary"
                android:background="?attr/selectableItemBackgroundBorderless"/>
        </LinearLayout>

        <!-- Price row -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingHorizontal="20dp" android:paddingBottom="12dp">
            <TextView
                android:id="@+id/tv_detail_price"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="44sp" android:textColor="@color/text_primary"
                android:fontFamily="sans-serif" android:textStyle="bold"
                android:letterSpacing="-0.02"/>
            <ImageView
                android:id="@+id/iv_token_logo"
                android:layout_width="36dp" android:layout_height="36dp"
                android:layout_marginStart="12dp"
                android:src="@mipmap/ic_launcher" android:padding="2dp"/>
            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
            <TextView
                android:id="@+id/tv_detail_change"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="20sp" android:textColor="@color/accent_green"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>

        <!-- 24H Stats -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp" android:paddingBottom="20dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="24H HIGH" android:textSize="11sp"
                    android:textColor="@color/text_tertiary" android:letterSpacing="0.08"/>
                <TextView android:id="@+id/tv_24h_high"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="14sp" android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-medium" android:layout_marginTop="2dp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="24H LOW" android:textSize="11sp"
                    android:textColor="@color/text_tertiary" android:letterSpacing="0.08"/>
                <TextView android:id="@+id/tv_24h_low"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="14sp" android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-medium" android:layout_marginTop="2dp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="24H VOL" android:textSize="11sp"
                    android:textColor="@color/text_tertiary" android:letterSpacing="0.08"/>
                <TextView android:id="@+id/tv_24h_volume"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="14sp" android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-medium" android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- TF Buttons — ĐÃ SỬA: 1H về bg_timeframe_normal, Java sẽ set đúng -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingHorizontal="20dp" android:paddingBottom="12dp"
            android:orientation="horizontal">
            <TextView android:id="@+id/btn_tf_1m"
                android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1"
                android:gravity="center" android:text="1M" android:textSize="14sp"
                android:textColor="@color/text_secondary" android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_timeframe_normal"/>
            <TextView android:id="@+id/btn_tf_5m"
                android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1"
                android:gravity="center" android:text="5M" android:textSize="14sp"
                android:textColor="@color/text_secondary" android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_timeframe_normal"/>
            <TextView android:id="@+id/btn_tf_15m"
                android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1"
                android:gravity="center" android:text="15M" android:textSize="14sp"
                android:textColor="@color/text_secondary" android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_timeframe_normal"/>
            <TextView android:id="@+id/btn_tf_1h"
                android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1"
                android:gravity="center" android:text="1H" android:textSize="14sp"
                android:textColor="@color/text_secondary" android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_timeframe_normal"/>
            <TextView android:id="@+id/btn_tf_1d"
                android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1"
                android:gravity="center" android:text="1D" android:textSize="14sp"
                android:textColor="@color/text_secondary" android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_timeframe_normal"/>
            <TextView android:id="@+id/btn_tf_1w"
                android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1"
                android:gravity="center" android:text="1W" android:textSize="14sp"
                android:textColor="@color/text_secondary" android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_timeframe_normal"/>
        </LinearLayout>

        <!-- Chart -->
        <com.github.mikephil.charting.charts.CandleStickChart
            android:id="@+id/candle_chart"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginHorizontal="8dp"
            android:layout_marginBottom="8dp"/>

        <!-- ── Candle Info Popup ───────────────────────────────── -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_candle_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="#1A39FF6E"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/accent_green"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <TextView
                    android:id="@+id/tv_candle_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="#888888"
                    android:fontFamily="sans-serif"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="horizontal">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="O  " android:textSize="12sp" android:textColor="#888888"/>
                        <TextView android:id="@+id/tv_candle_open"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="13sp" android:textColor="#FFFFFF"
                            android:fontFamily="sans-serif-medium"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="horizontal">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="H  " android:textSize="12sp" android:textColor="#888888"/>
                        <TextView android:id="@+id/tv_candle_high"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="13sp" android:textColor="#39FF6E"
                            android:fontFamily="sans-serif-medium"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="horizontal">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="L  " android:textSize="12sp" android:textColor="#888888"/>
                        <TextView android:id="@+id/tv_candle_low"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="13sp" android:textColor="#FF4444"
                            android:fontFamily="sans-serif-medium"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="horizontal">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="C  " android:textSize="12sp" android:textColor="#888888"/>
                        <TextView android:id="@+id/tv_candle_close"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="13sp" android:textColor="#FFFFFF"
                            android:fontFamily="sans-serif-medium"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Vol  " android:textSize="12sp" android:textColor="#888888"/>
                    <TextView android:id="@+id/tv_candle_volume"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="13sp" android:textColor="#FFFFFF"
                        android:fontFamily="sans-serif-medium"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- AI Sentiment -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_sentiment_detail"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp" android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/bg_card" app:cardCornerRadius="16dp"
            app:cardElevation="0dp" app:strokeColor="@color/border" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="24dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="20dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="ĐIỂM ĐÁNH GIÁ"
                        android:textSize="13sp" android:textColor="@color/text_secondary"
                        android:letterSpacing="0.08" android:fontFamily="sans-serif"/>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:background="@drawable/bg_search" android:orientation="horizontal"
                        android:padding="2dp">
                        <TextView android:id="@+id/btn_sent_1h"
                            android:layout_width="44dp" android:layout_height="28dp"
                            android:gravity="center" android:text="1H" android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:background="@android:color/transparent"/>
                        <TextView android:id="@+id/btn_sent_1d"
                            android:layout_width="44dp" android:layout_height="28dp"
                            android:gravity="center" android:text="1D" android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:background="@android:color/transparent"/>
                        <TextView android:id="@+id/btn_sent_1w"
                            android:layout_width="44dp" android:layout_height="28dp"
                            android:gravity="center" android:text="1W" android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:background="@android:color/transparent"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center" android:orientation="vertical">
                    <TextView android:id="@+id/tv_detail_sentiment"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="--" android:textSize="64sp"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="/ 100" android:textSize="14sp"
                        android:textColor="@color/text_tertiary" android:fontFamily="sans-serif"/>
                    <TextView android:id="@+id/tv_detail_sentiment_label"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="LOADING..." android:textSize="15sp"
                        android:textColor="@color/bg_primary"
                        android:fontFamily="sans-serif" android:textStyle="bold"
                        android:background="@drawable/btn_green_gradient"
                        android:paddingHorizontal="20dp" android:paddingVertical="8dp"
                        android:layout_marginTop="12dp"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Technical Indicators -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_indicators"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp" android:layout_marginBottom="32dp"
            app:cardBackgroundColor="@color/bg_card" app:cardCornerRadius="16dp"
            app:cardElevation="0dp" app:strokeColor="@color/border" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="24dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="24dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="TỔNG QUAN KỸ THUẬT"
                        android:textSize="13sp" android:textColor="@color/text_secondary"
                        android:letterSpacing="0.08" android:fontFamily="sans-serif-medium"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Real-time" android:textSize="11sp"
                        android:textColor="@color/accent_green" android:fontFamily="sans-serif-medium"
                        android:background="#1A39FF6E"
                        android:paddingHorizontal="8dp" android:paddingVertical="4dp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="20dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="RSI (14)" android:textSize="12sp" android:textColor="@color/text_secondary"/>
                        <TextView android:id="@+id/tv_detail_rsi"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="16sp" android:textColor="@color/text_primary"
                            android:fontFamily="sans-serif-medium" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="TÍN HIỆU MACD" android:textSize="12sp" android:textColor="@color/text_secondary"/>
                        <TextView android:id="@+id/tv_detail_macd"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="16sp" android:textColor="@color/text_primary"
                            android:fontFamily="sans-serif-medium" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="20dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="ĐƯỜNG EMA (20)" android:textSize="12sp" android:textColor="@color/text_secondary"/>
                        <TextView android:id="@+id/tv_detail_ema20"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="16sp" android:textColor="@color/text_primary"
                            android:fontFamily="sans-serif-medium" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="ĐƯỜNG EMA (50)" android:textSize="12sp" android:textColor="@color/text_secondary"/>
                        <TextView android:id="@+id/tv_detail_ema50"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="16sp" android:textColor="@color/text_primary"
                            android:fontFamily="sans-serif-medium" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="HỖ TRỢ (SUP)" android:textSize="12sp" android:textColor="@color/text_secondary"/>
                        <TextView android:id="@+id/tv_detail_support"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="16sp" android:textColor="@color/text_primary"
                            android:fontFamily="sans-serif-medium" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="TÂM LÝ (F&amp;G)" android:textSize="12sp" android:textColor="@color/text_secondary"/>
                        <TextView android:id="@+id/tv_detail_fear_greed"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="16sp" android:textColor="@color/text_primary"
                            android:fontFamily="sans-serif-medium" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>