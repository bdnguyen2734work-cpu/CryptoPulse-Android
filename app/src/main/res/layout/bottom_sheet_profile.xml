<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_card"
    android:paddingBottom="32dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="24dp"
        android:background="@color/border"/>

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="24dp">

        <ImageView
            android:id="@+id/iv_avatar"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@drawable/bg_avatar"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_profile"
            app:tint="@color/accent_green"/>

        <androidx.cardview.widget.CardView
            android:id="@+id/btn_change_avatar"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="bottom|end"
            app:cardBackgroundColor="@color/accent_green"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/bg_card"
            app:strokeWidth="2dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@android:drawable/ic_menu_camera"
                android:padding="6dp"
                app:tint="@color/bg_primary"/>
        </androidx.cardview.widget.CardView>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tên hiển thị"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="6dp"/>
        <EditText
            android:id="@+id/et_profile_username"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_search"
            android:paddingHorizontal="16dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:fontFamily="sans-serif"
            android:hint="Ví dụ: CryptoPulse Member"
            android:textColorHint="@color/text_tertiary"
            android:singleLine="true"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email đăng ký"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="6dp"/>
        <EditText
            android:id="@+id/et_profile_email"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_search"
            android:paddingHorizontal="16dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:fontFamily="sans-serif"
            android:inputType="textEmailAddress"
            android:hint="example@email.com"
            android:textColorHint="@color/text_tertiary"
            android:singleLine="true"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Số điện thoại"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="6dp"/>
        <EditText
            android:id="@+id/et_profile_phone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_search"
            android:paddingHorizontal="16dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:fontFamily="sans-serif"
            android:inputType="phone"
            android:hint="0123 456 789"
            android:textColorHint="@color/text_tertiary"
            android:singleLine="true"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btn_save_profile"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="LƯU THAY ĐỔI"
            android:textColor="@color/bg_primary"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:background="@drawable/btn_green_selector"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_marginBottom="20dp"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:id="@+id/item_settings"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:background="?attr/selectableItemBackground">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cài đặt (Settings)"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif"/>
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_nav_market"
                app:tint="@color/text_secondary"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/item_backend_url"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:background="?attr/selectableItemBackground">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cấu hình Backend"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif"/>
                <TextView
                    android:id="@+id/tv_backend_url"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="sans-serif"/>
            </LinearLayout>
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_nav_market"
                app:tint="@color/text_secondary"/>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btn_logout"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="24dp"
        android:text="ĐĂNG XUẤT"
        android:textColor="#FF4444"
        android:textSize="14sp"
        android:fontFamily="sans-serif"
        android:textStyle="bold"
        android:background="@drawable/bg_logout_btn"
        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
</LinearLayout>