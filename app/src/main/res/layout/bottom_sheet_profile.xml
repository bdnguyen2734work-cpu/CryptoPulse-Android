<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_marginBottom="24dp"
            android:background="#40FFFFFF" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp">

            <ImageView
                android:id="@+id/iv_avatar"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:background="@drawable/circle_bg"
                android:padding="20dp"
                android:src="@drawable/ic_user"
                app:tint="#00E676" />

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/circle_bg_green"
                android:padding="6dp"
                android:src="@drawable/ic_camera"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:textColorHint="#888888"
            app:boxBackgroundColor="#1E1E1E"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeColor="#00E676"
            app:hintTextColor="#00E676">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_profile_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Tên hiển thị"
                android:textColor="#FFFFFF"
                android:inputType="textPersonName" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:boxBackgroundColor="#151515"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeWidth="0dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_profile_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Email đăng ký (Không thể đổi)"
                android:textColor="#888888"
                android:enabled="false" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:textColorHint="#888888"
            app:boxBackgroundColor="#1E1E1E"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeColor="#00E676"
            app:hintTextColor="#00E676">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_profile_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Số điện thoại"
                android:textColor="#FFFFFF"
                android:inputType="phone" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_profile"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="32dp"
            android:text="LƯU THAY ĐỔI"
            android:textColor="#121212"
            android:textStyle="bold"
            app:backgroundTint="#00E676"
            app:cornerRadius="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF"
            android:layout_marginBottom="16dp"/>

        <!-- NÚT ĐĂNG TIN TỨC -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_admin_post_news"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="12dp"
            android:text="ĐĂNG TIN TỨC (ADMIN)"
            android:textColor="#121212"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="#39FF6E"
            app:cornerRadius="12dp"/>

        <!-- NÚT QUẢN LÝ USER -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_admin_user"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="12dp"
            android:text="QUẢN LÝ NGƯỜI DÙNG (ADMIN)"
            android:textColor="#121212"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="#00E676"
            app:cornerRadius="12dp"/>

        <!-- NÚT THỐNG KÊ DASHBOARD VỪA THÊM -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_admin_dashboard"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="12dp"
            android:text="THỐNG KÊ DASHBOARD (ADMIN)"
            android:textColor="#121212"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="#00E676"
            app:cornerRadius="12dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_logout"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="ĐĂNG XUẤT"
            android:textColor="#FF5252"
            android:textStyle="bold"
            app:strokeColor="#FF5252"
            app:strokeWidth="1.5dp"
            app:cornerRadius="12dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>