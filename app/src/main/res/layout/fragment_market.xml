<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_primary">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="20dp" android:orientation="horizontal" android:gravity="center_vertical">

        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Thị trường"
            android:textSize="26sp" android:textColor="@color/text_primary"
            android:fontFamily="sans-serif" android:textStyle="bold"/>

    </LinearLayout>

    <EditText
        android:id="@+id/et_search_market"
        android:layout_width="match_parent" android:layout_height="46dp"
        android:layout_marginHorizontal="20dp" android:layout_marginBottom="16dp"
        android:background="@drawable/bg_search"
        android:paddingHorizontal="16dp"
        android:hint="Tìm kiếm coin..." android:textColorHint="@color/text_tertiary"
        android:textColor="@color/text_primary" android:textSize="14sp"
        android:fontFamily="sans-serif"
        android:inputType="text" android:imeOptions="actionSearch"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingHorizontal="20dp" android:paddingBottom="16dp"
        android:orientation="horizontal" android:gravity="center_vertical">

        <TextView android:layout_width="32dp" android:layout_height="wrap_content"
            android:text="#" android:textSize="14sp"
            android:textColor="@color/text_tertiary" android:fontFamily="sans-serif-medium"
            android:layout_marginEnd="10dp"/>

        <TextView android:id="@+id/btn_sort_price"
            android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1.2"
            android:gravity="center"
            android:text="GIÁ ↕" android:textSize="13sp" android:textColor="@color/text_secondary"
            android:fontFamily="sans-serif-medium" android:background="@drawable/bg_timeframe_normal"
            android:layout_marginEnd="8dp"/>

        <TextView android:id="@+id/btn_sort_change"
            android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
            android:gravity="center"
            android:text="24H ↕" android:textSize="13sp" android:textColor="@color/accent_green"
            android:fontFamily="sans-serif-medium" android:background="@drawable/bg_timeframe_selected"
            android:layout_marginEnd="8dp"/>

        <TextView android:id="@+id/btn_sort_volume"
            android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1.2"
            android:gravity="center"
            android:text="KHỐI LƯỢNG GD↕" android:textSize="12sp" android:textColor="@color/text_secondary"
            android:fontFamily="sans-serif-medium" android:background="@drawable/bg_timeframe_normal"/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/divider"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_market"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingBottom="80dp"
        android:clipToPadding="false"
        android:overScrollMode="never"/>

</LinearLayout>